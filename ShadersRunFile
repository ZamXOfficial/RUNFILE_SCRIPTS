    local manualTitle = make("TextLabel", {Position=UDim2.new(0,0,0.43,0), Size=UDim2.new(1,0,0,20), BackgroundTransparency=1, Text="РУЧНЫЕ НАСТРОЙКИ", TextColor3=Color3.fromRGB(130,190,151), Font=Enum.Font.GothamBold, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, content)
    local manualFrame = make("ScrollingFrame", {Position=UDim2.new(0,0,0.43,23), Size=UDim2.new(1,0,0.57,-23), BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=3, CanvasSize=UDim2.new()}, content)
    local manualLayout = make("UIListLayout", {Padding=UDim.new(0,7), SortOrder=Enum.SortOrder.LayoutOrder}, manualFrame)
    manualLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        manualFrame.CanvasSize = UDim2.new(0,0,0,manualLayout.AbsoluteContentSize.Y+8)
    end)

    local selectedButton
    local function selectPreset(name)
        currentPreset = name
        if enabled then applyPreset(name) end
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = child.Name == name and Color3.fromRGB(30,105,62) or Color3.fromRGB(20,29,24)
            end
        end
    end
    for index, name in ipairs({"Scarlet Atmosphere","Golden Hour","Night","Neon Night","Lost Ocean","Dreamy","Colorful"}) do
        local button = make("TextButton", {
            Name=name, LayoutOrder=index, Size=UDim2.new(1,0,0,25),
            BackgroundColor3=name==currentPreset and Color3.fromRGB(30,105,62) or Color3.fromRGB(20,29,24),
            Text=name, TextColor3=Color3.fromRGB(220,235,225), Font=Enum.Font.Gotham, TextSize=11
        }, list)
        make("UICorner", {CornerRadius=UDim.new(0,5)}, button)
        button.MouseButton1Click:Connect(function() selectPreset(name) end)
    end

    local function addSlider(label, key, minValue, maxValue, initial)
        local row = make("Frame", {Size=UDim2.new(1,0,0,38), BackgroundTransparency=1}, manualFrame)
        local caption = make("TextLabel", {Size=UDim2.new(1,0,0,15), BackgroundTransparency=1, Text=label.."  "..string.format("%.2f", initial), TextColor3=Color3.fromRGB(205,220,210), Font=Enum.Font.Gotham, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, row)
        local track = make("Frame", {Position=UDim2.new(0,0,0,21), Size=UDim2.new(1,0,0,5), BackgroundColor3=Color3.fromRGB(45,58,49), BorderSizePixel=0}, row)
        make("UICorner", {CornerRadius=UDim.new(1,0)}, track)
        local fill = make("Frame", {Size=UDim2.new((initial-minValue)/(maxValue-minValue),0,1,0), BackgroundColor3=Color3.fromRGB(55,190,105), BorderSizePixel=0}, track)
        make("UICorner", {CornerRadius=UDim.new(1,0)}, fill)
        local knob = make("TextButton", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new((initial-minValue)/(maxValue-minValue),0,0.5,0), Size=UDim2.fromOffset(12,12), BackgroundColor3=Color3.fromRGB(225,245,230), Text="", AutoButtonColor=false}, track)
        make("UICorner", {CornerRadius=UDim.new(1,0)}, knob)
        local draggingSlider = false
        local function setValue(value, shouldApply)
            value = math.clamp(value, minValue, maxValue)
            local alpha = (value-minValue)/(maxValue-minValue)
            fill.Size = UDim2.new(alpha,0,1,0)
            knob.Position = UDim2.new(alpha,0,0.5,0)
            caption.Text = label.."  "..string.format("%.2f", value)
            if shouldApply ~= false then applyManual(key,value) end
        end
        sliderSetters[key] = setValue
        local function setFromX(x)
            local alpha = math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
            local value = minValue+(maxValue-minValue)*alpha
            value = math.floor(value*100+0.5)/100
            setValue(value,true)
        end
        knob.MouseButton1Down:Connect(function() draggingSlider=true end)
        track.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                draggingSlider=true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then draggingSlider=false end
        end)
    end
    addSlider("Уровень шейдера","Level",0,2,manual.Level)
    addSlider("Яркость","Brightness",0,5,manual.Brightness)
    addSlider("Экспозиция","Exposure",-3,3,manual.Exposure)
    addSlider("Bloom","BloomIntensity",0,3,manual.BloomIntensity)
    addSlider("Насыщенность","Saturation",-1,1,manual.Saturation)

    local tintRow = make("Frame", {Size=UDim2.new(1,0,0,27), BackgroundTransparency=1}, manualFrame)
    make("TextLabel", {Size=UDim2.new(0.72,0,1,0), BackgroundTransparency=1, Text="Цветовой оттенок", TextColor3=Color3.fromRGB(205,220,210), Font=Enum.Font.Gotham, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, tintRow)
    local tintButton = make("TextButton", {
        AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,0,0.5,0),
        Size=UDim2.fromOffset(24,22), BackgroundColor3=manual.TintColor,
        Text="", BorderSizePixel=0, AutoButtonColor=true
    }, tintRow)
    make("UICorner", {CornerRadius=UDim.new(0,5)}, tintButton)
    make("UIStroke", {Color=Color3.fromRGB(210,230,215), Thickness=1, Transparency=0.25}, tintButton)

    local tintPicker = make("Frame", {
        Size=UDim2.new(1,0,0,122), BackgroundColor3=Color3.fromRGB(13,20,16),
        BorderSizePixel=0, Visible=false
    }, manualFrame)
    make("UICorner", {CornerRadius=UDim.new(0,6)}, tintPicker)
    make("UIPadding", {PaddingLeft=UDim.new(0,7), PaddingRight=UDim.new(0,7), PaddingTop=UDim.new(0,3), PaddingBottom=UDim.new(0,3)}, tintPicker)

    local tintR = math.floor(manual.TintColor.R*255+0.5)
    local tintG = math.floor(manual.TintColor.G*255+0.5)
    local tintB = math.floor(manual.TintColor.B*255+0.5)
    local tintBrightness = 1
    local tintSetters = {}

    local function refreshTint()
        local color = Color3.new(
            (tintR/255)*tintBrightness,
            (tintG/255)*tintBrightness,
            (tintB/255)*tintBrightness
        )
        tintButton.BackgroundColor3 = color
        applyManual("TintColor",color)
    end

    local function addTintSlider(label, initial, minValue, maxValue, order, channel)
        local row = make("Frame", {
            Position=UDim2.new(0,0,0,(order-1)*29), Size=UDim2.new(1,0,0,25),
            BackgroundTransparency=1
        }, tintPicker)
        local caption = make("TextLabel", {
            Size=UDim2.fromOffset(34,24), BackgroundTransparency=1,
            Text=label, TextColor3=Color3.fromRGB(195,215,200),
            Font=Enum.Font.GothamBold, TextSize=9, TextXAlignment=Enum.TextXAlignment.Left
        }, row)
        local valueText = make("TextLabel", {
            AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,0,0,0),
            Size=UDim2.fromOffset(28,24), BackgroundTransparency=1,
            Text=tostring(math.floor(initial+0.5)), TextColor3=Color3.fromRGB(175,195,180),
            Font=Enum.Font.Gotham, TextSize=9, TextXAlignment=Enum.TextXAlignment.Right
        }, row)
        local track = make("Frame", {
            Position=UDim2.new(0,35,0,10), Size=UDim2.new(1,-70,0,5),
            BackgroundColor3=Color3.fromRGB(50,60,52), BorderSizePixel=0
        }, row)
        make("UICorner", {CornerRadius=UDim.new(1,0)}, track)
        if channel == "Brightness" then
            make("UIGradient", {
                Color=ColorSequence.new({
                    ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),
                    ColorSequenceKeypoint.new(1,Color3.new(0,0,0))
                })
            }, track)
        else
            local channelColor = channel=="R" and Color3.fromRGB(235,75,75)
                or (channel=="G" and Color3.fromRGB(75,210,110) or Color3.fromRGB(75,135,245))
            track.BackgroundColor3 = channelColor:Lerp(Color3.fromRGB(30,35,31),0.45)
        end
        local alpha = (initial-minValue)/(maxValue-minValue)
        local knob = make("TextButton", {
            AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(alpha,0,0.5,0),
            Size=UDim2.fromOffset(11,11), BackgroundColor3=Color3.fromRGB(245,250,245),
            Text="", BorderSizePixel=0, AutoButtonColor=false
        }, track)
        make("UICorner", {CornerRadius=UDim.new(1,0)}, knob)
        local draggingColor = false
        local function setValue(value, apply)
            value = math.clamp(value,minValue,maxValue)
            local a = (value-minValue)/(maxValue-minValue)
            knob.Position = UDim2.new(a,0,0.5,0)
            valueText.Text = channel=="Brightness" and string.format("%.2f",value) or tostring(math.floor(value+0.5))
            if channel=="R" then tintR=value
            elseif channel=="G" then tintG=value
            elseif channel=="B" then tintB=value
            else tintBrightness=value end
            if apply then refreshTint() end
        end
        tintSetters[channel] = setValue
        local function setFromX(x)
            local a = math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
            setValue(minValue+(maxValue-minValue)*a,true)
        end
        knob.MouseButton1Down:Connect(function() draggingColor=true end)
        track.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                draggingColor=true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingColor and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then draggingColor=false end
        end)
    end

    addTintSlider("R",tintR,0,255,1,"R")
    addTintSlider("G",tintG,0,255,2,"G")
    addTintSlider("B",tintB,0,255,3,"B")
    addTintSlider("Ярк.",tintBrightness,0,1,4,"Brightness")

    updateTintControls = function(color)
        tintR = math.floor(color.R*255+0.5)
        tintG = math.floor(color.G*255+0.5)
        tintB = math.floor(color.B*255+0.5)
        tintBrightness = 1
        if tintSetters.R then tintSetters.R(tintR,false) end
        if tintSetters.G then tintSetters.G(tintG,false) end
        if tintSetters.B then tintSetters.B(tintB,false) end
        if tintSetters.Brightness then tintSetters.Brightness(1,false) end
        tintButton.BackgroundColor3 = color
    end

    tintButton.MouseButton1Click:Connect(function()
        tintPicker.Visible = not tintPicker.Visible
    end)

    local function setEnabled(state)
        enabled = state
        activate.Text = state and "●  Активировать: ВКЛ" or "●  Активировать: ВЫКЛ"
        activate.BackgroundColor3 = state and Color3.fromRGB(35,135,75) or Color3.fromRGB(25,90,55)
        if state then applyPreset(currentPreset) else removeEffects(); restoreLighting() end
    end
    activate.MouseButton1Click:Connect(function() setEnabled(not enabled) end)

    -- Slow intro: reveal the logo, unfold the panel, then settle the mark into the panel header.
    panel.Size = UDim2.fromScale(0.10,0.10)
    panel.Position = UDim2.fromScale(0.5,0.54)
    panel.BackgroundTransparency = 1
    panel.Rotation = -1.5
    tween(shade,0.95,{BackgroundTransparency=0.28},Enum.EasingStyle.Sine)
    tween(logo,1.25,{TextTransparency=0,TextStrokeTransparency=0.05},Enum.EasingStyle.Sine)
    task.wait(1.05)
    tween(panel,1.45,{
        Size=UDim2.fromScale(0.25,0.5),
        BackgroundTransparency=0.04,
        Rotation=0
    },Enum.EasingStyle.Quint)
    tween(stroke,1.1,{Transparency=0.12},Enum.EasingStyle.Sine)
    tween(logo,1.6,{
        Position=UDim2.new(0.375,31,0.29,20),
        Size=UDim2.fromOffset(38,38),
        Rotation=0,
        TextSize=42
    },Enum.EasingStyle.Sine)
    task.wait(0.55)
    local greeting = "Здравствуй"
    for i=1,utf8.len(greeting) do
        local nextByte = utf8.offset(greeting, i+1)
        header.Text = string.sub(greeting, 1, nextByte and nextByte-1 or #greeting)
        header.TextTransparency=1
        tween(header,0.22,{TextTransparency=0},Enum.EasingStyle.Sine)
        task.wait(0.18)
    end
    shade.BackgroundTransparency=1
    -- Keep the brand mark as a compact top-center emblem above the window.
    logo.TextSize=48
    logo.Position=UDim2.new(0.5,0,0,34)
    logo.Size=UDim2.fromOffset(58,58)
    logo.Rotation=360
    logo.TextStrokeTransparency=0.05
    shade.BackgroundTransparency=1
end, debug.traceback)

if not ok then
    warn("[RunFile Shaders] "..tostring(err))
    shutdown()
end

-- Keep a cleanup hook available to this executor session.
if alive then
    ENV["__RUNFILE_SHADERS_CLEANUP"] = function() shutdown(false) end
end
