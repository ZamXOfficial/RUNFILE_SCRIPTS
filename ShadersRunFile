local function applyShaderLevel()
    local preset = presets[currentPreset]
    if not preset then return end
    local strength = math.clamp(manual.Level or 1, 0, 2)
    local blend = math.clamp(strength, 0, 1)

    -- Blend the preset's color atmosphere against the pre-inject lighting.
    for _, key in ipairs({"ColorShift_Bottom", "ColorShift_Top", "OutdoorAmbient", "FogColor", "Ambient"}) do
        local base = originalLighting[key]
        local target = preset.Lighting and preset.Lighting[key]
        if typeof(base) == "Color3" and typeof(target) == "Color3" then
            pcall(function() Lighting[key] = base:Lerp(target, blend) end)
        end
    end

    for _, effect in ipairs(createdEffects) do
        if effect:IsA("BloomEffect") then
            effect.Intensity = (manual.BloomIntensity or 0) * strength
        elseif effect:IsA("BlurEffect") then
            local base = preset.Blur and preset.Blur.Size or 0
            effect.Size = base * strength
        elseif effect:IsA("ColorCorrectionEffect") then
            local cc = preset.CC or {}
            effect.Brightness = (cc.Brightness or 0) * strength
            effect.Contrast = (cc.Contrast or 0) * strength
            effect.Saturation = (manual.Saturation or 0) * strength
            effect.TintColor = Color3.new(1, 1, 1):Lerp(manual.TintColor or Color3.new(1, 1, 1), blend)
        elseif effect:IsA("SunRaysEffect") then
            local rays = preset.SunRays or {}
            effect.Intensity = (rays.Intensity or 0) * strength
            effect.Spread = rays.Spread or effect.Spread
        elseif effect:IsA("Atmosphere") then
            local atmosphere = preset.Atmosphere or {}
            effect.Density = (atmosphere.Density or 0) * strength
            effect.Haze = (atmosphere.Haze or 0) * strength
            effect.Glare = (atmosphere.Glare or 0) * strength
            if atmosphere.Color then effect.Color = Color3.new(1, 1, 1):Lerp(atmosphere.Color, blend) end
            if atmosphere.Decay then effect.Decay = Color3.new(1, 1, 1):Lerp(atmosphere.Decay, blend) end
        end
    end
end

local function applyPreset(name)
    local preset = presets[name]
    if not preset then return end
    currentPreset = name
    removeEffects()
    restoreLighting()
    for key, value in pairs(preset.Lighting or {}) do
        pcall(function() Lighting[key] = value end)
    end
    if preset.Bloom then
        local e = newEffect("BloomEffect", "Bloom")
        for k,v in pairs(preset.Bloom) do e[k] = v end
    end
    if preset.Blur then
        local e = newEffect("BlurEffect", "Blur")
        e.Size = preset.Blur.Size
    end
    if preset.CC then
        local e = newEffect("ColorCorrectionEffect", "ColorCorrection")
        for k,v in pairs(preset.CC) do e[k] = v end
    end
    if preset.SunRays then
        local e = newEffect("SunRaysEffect", "SunRays")
        for k,v in pairs(preset.SunRays) do e[k] = v end
    end
    if preset.Atmosphere then
        local e = newEffect("Atmosphere", "Atmosphere")
        for k,v in pairs(preset.Atmosphere) do e[k] = v end
    end

    manual.Brightness = Lighting.Brightness
    manual.Exposure = Lighting.ExposureCompensation
    for _, effect in ipairs(createdEffects) do
        if effect:IsA("BloomEffect") then manual.BloomIntensity = effect.Intensity end
        if effect:IsA("ColorCorrectionEffect") then
            manual.Saturation = effect.Saturation
            manual.TintColor = effect.TintColor
        end
    end
    applyShaderLevel()

    for key, value in pairs({
        Level = manual.Level,
        Brightness = manual.Brightness,
        Exposure = manual.Exposure,
        BloomIntensity = manual.BloomIntensity,
        Saturation = manual.Saturation,
    }) do
        if sliderSetters[key] then sliderSetters[key](value, false) end
    end
    if updateTintControls then updateTintControls(manual.TintColor) end
end

local function applyManual(key, value)
    manual[key] = value
    if not enabled then return end
    if key == "Brightness" then
        Lighting.Brightness = value
    elseif key == "Exposure" then
        Lighting.ExposureCompensation = value
    elseif key == "Level" or key == "BloomIntensity" or key == "Saturation" or key == "TintColor" then
        applyShaderLevel()
    end
end

local function tween(obj, duration, props, style, direction)
    local t = TweenService:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function make(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function shutdown(keepSettings)
    if not alive then return end
    alive = false
    enabled = false
    if not keepSettings then
        removeEffects()
        restoreLighting()
        ENV[GUARD_KEY] = nil
        ENV["__RUNFILE_SHADERS_CLEANUP"] = nil
    else
        -- Keep the applied visual state; the cleanup hook can still restore it manually.
        ENV[GUARD_KEY] = true
        ENV["__RUNFILE_SHADERS_CLEANUP"] = function()
            removeEffects()
            restoreLighting()
            ENV[GUARD_KEY] = nil
            ENV["__RUNFILE_SHADERS_CLEANUP"] = nil
        end
    end
    if gui then pcall(function() gui:Destroy() end) end
end

